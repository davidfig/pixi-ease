{
    "name": "pixi-ease",
    "version": "4.0.0",
    "description": "an animation library using easing functions",
    "types": "@types/index.d.ts",
    "main": "dist/ease.js",
    "module": "dist/ease.es.js",
    "scripts": {
        "test": "yarn test:types && mocha",
        "build": "rollup -c rollup.config.js",
        "dev": "rollup -c rollup.dev.js --watch",
        "docs": "jsdoc -c docs/jsdoc.conf.json",
        "demo": "rollup -c docs/rollup.config.js",
        "prepublishOnly": "yarn build && yarn docs && yarn demo && yarn test",
        "test:types": "tsc -p test/tsconfig.json"
    },
    "keywords": [
        "ease",
        "pixi",
        "pixi.js",
        "easing",
        "animation",
        "animate",
        "webgl"
    ],
    "files": [
        "dist",
        "@types"
    ],
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/davidfig/pixi-ease.git"
    },
    "author": "david figatner",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/davidfig/pixi-ease/issues"
    },
    "homepage": "https://github.com/davidfig/pixi-ease#readme",
    "dependencies": {
        "eventemitter3": "^5",
        "penner": "^0.1.3"
    },
    "peerDependencies": {
        "pixi.js": "^8"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.2",
        "chai": "^4.5.0",
        "fork-me-github": "^1.2.0",
        "highlight.js": "^11.12.0",
        "jsdoc": "^4.0.5",
        "mocha": "^12.0.3",
        "pixi.js": "^8.22",
        "raf": "^3.4.1",
        "rollup": "^4",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "rollup-plugin-serve": "^3.0.0",
        "typescript": "^7.0.2",
        "yy-fps": "^2.0.1",
        "yy-jsdoc-template": "^1.3.0",
        "yy-random": "^1.10.2"
    }
}
